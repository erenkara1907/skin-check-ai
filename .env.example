# ============================================
# SkinCheck AI — Client Environment
# ============================================
# Copy this file to .env and fill in your values.
#
# Server-only secrets are stored in Supabase Vault
# and accessed by Edge Functions at runtime.
# To manage them: Supabase Dashboard > Project Settings > Vault

# ── Supabase (Client-safe — public by design) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Google Sign-In ──
GOOGLE_CLIENT_ID_IOS=
GOOGLE_WEB_CLIENT_ID=
